            "content": "package main\nimport \"fmt\"\n\nfunc quadrado (n int) int {\n    if n == 1 {\n        fmt.Printf(\"%d^2 = %d\\n\", n, 1)\n        return 1\n    }\n    fmt.Printf(\"%d^2 = %d^2 + 2*%d + 1 = ?\\n\", n, n-1, n-1)\n\n    rec := quadrado (n-1)\n\n    resultado := rec + 2*(n-1) + 1\n\n    fmt.Printf(\"%d^2 = %d^2 + 2*%d + 1 = %d\\n\", n, n-1, n-1, resultado)\n\n    return resultado\n}\n\nfunc main() {\n    var x int \n    fmt.Scanln(&x)\n    \n    quadrado(x)\n}\n",
